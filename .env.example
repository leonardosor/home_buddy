# Required for auto-fill (beds/baths/sqft, comps, AVM). App still works without it,
# just falls to manual entry.
RENTCAST_API_KEY=

# Optional. Enables real street-level photos of the subject property and comps
# (via Google's Street View Static API). Without it, the app falls back to a free
# keyless aerial thumbnail, then a placeholder if no coordinates are available.
# Get one at https://console.cloud.google.com (enable "Street View Static API").
GOOGLE_MAPS_API_KEY=
